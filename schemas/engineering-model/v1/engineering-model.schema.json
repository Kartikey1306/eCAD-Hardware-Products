{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://embeddedos.org/schemas/engineering-model/v1/engineering-model.schema.json",
  "title": "eCAD Engineering Semantic Model v1",
  "description": "The bridge between CAD and every domain model. Physical structure comes from the CAD; design intent the CAD cannot carry comes from annotations; nothing is invented. Units are SI throughout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "model_version",
    "design",
    "components",
    "joints",
    "relationships",
    "unknowns"
  ],
  "properties": {
    "$schema": {
      "const": "https://embeddedos.org/schemas/engineering-model/v1/engineering-model.schema.json"
    },
    "model_version": {
      "description": "The format version. A compatible addition raises the minor version: every minor version of v1 is accepted, and a document that uses an addition must declare the version that introduced it (1.1.0: the circuit member and the electrical component kinds; 1.2.0: the hdl member).",
      "enum": ["1.0.0", "1.1.0", "1.2.0"]
    },
    "design": {"$ref": "#/definitions/design"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/component"}
    },
    "joints": {"type": "array", "items": {"$ref": "#/definitions/joint"}},
    "relationships": {"type": "array", "items": {"$ref": "#/definitions/relationship"}},
    "unknowns": {
      "description": "Index of every quantity with a null status (UNKNOWN, UNSPECIFIED, NOT_AVAILABLE), with its status and the domains that need it. Generated; never hand-edited.",
      "type": "array",
      "items": {"$ref": "#/definitions/unknown"}
    }
  },
  "allOf": [
    {
      "description": "A model that uses an addition of format 1.1.0 (a circuit member, or an electrical component kind) declares 1.1.0, so a 1.0.0 reader is never handed members it does not know.",
      "if": {
        "properties": {
          "components": {
            "contains": {
              "anyOf": [
                {"required": ["circuit"]},
                {"required": ["kind"], "properties": {"kind": {"enum": ["fuse", "resistor", "capacitor", "switch", "voltage_source", "current_source"]}}}
              ]
            }
          }
        }
      },
      "then": {"properties": {"model_version": {"const": "1.1.0"}}}
    },
    {
      "description": "A model that uses the addition of format 1.2.0 (an hdl member) declares 1.2.0.",
      "if": {"properties": {"components": {"contains": {"required": ["hdl"]}}}},
      "then": {"properties": {"model_version": {"const": "1.2.0"}}}
    }
  ],
  "definitions": {
    "quantity": {"$ref": "common.schema.json#/definitions/quantity"},
    "identifier": {"$ref": "common.schema.json#/definitions/identifier"},
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_id", "name", "revision", "sources"],
      "properties": {
        "design_id": {"$ref": "#/definitions/identifier"},
        "name": {"$ref": "common.schema.json#/definitions/nonEmptyString"},
        "revision": {"$ref": "common.schema.json#/definitions/nonEmptyString"},
        "sources": {
          "description": "The source artefacts the model was built from, by repository path and hash. Any domain's artefact: a CAD assembly, a netlist, HDL.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "format", "sha256"],
            "properties": {
              "path": {"$ref": "common.schema.json#/definitions/relativePath"},
              "format": {"$ref": "common.schema.json#/definitions/identifier"},
              "sha256": {"$ref": "common.schema.json#/definitions/sha256"},
              "length_unit": {
                "description": "Length unit a CAD artefact declares; the model converts to metres.",
                "enum": ["mm", "m", "inch"]
              }
            }
          }
        },
        "gravity": {
          "description": "Gravity in assembly axes, for designs whose physics it affects. A digital or electrical design has none.",
          "$ref": "#/definitions/quantity"
        }
      }
    },
    "cadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "occurrence"],
      "properties": {
        "part": {"$ref": "common.schema.json#/definitions/nonEmptyString"},
        "occurrence": {"$ref": "common.schema.json#/definitions/nonEmptyString"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "name", "kind", "cad_ref", "material", "geometry", "physical", "placement", "domains"],
      "properties": {
        "component_id": {"$ref": "#/definitions/identifier"},
        "name": {"$ref": "common.schema.json#/definitions/nonEmptyString"},
        "kind": {
          "enum": [
            "structure",
            "shaft",
            "payload",
            "bearing",
            "fastener",
            "housing",
            "motor",
            "gearbox",
            "motor_driver",
            "battery",
            "sensor",
            "controller",
            "pcb",
            "fuse",
            "resistor",
            "capacitor",
            "switch",
            "voltage_source",
            "current_source",
            "other"
          ]
        },
        "circuit": {
          "description": "Where a netlist element sits in its circuit (format 1.1.0). Nets are derived from the terminals, never stored.",
          "$ref": "#/definitions/circuit"
        },
        "hdl": {"$ref": "#/definitions/hdl"},
        "cad_ref": {
          "description": "null means the component is part of the design but not represented in the CAD.",
          "oneOf": [{"$ref": "#/definitions/cadRef"}, {"type": "null"}]
        },
        "material": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "density"],
              "properties": {
                "name": {"$ref": "common.schema.json#/definitions/nonEmptyString"},
                "density": {"$ref": "#/definitions/quantity"}
              }
            }
          ]
        },
        "geometry": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["volume", "surface_area", "bounding_box_local"],
              "properties": {
                "volume": {"$ref": "#/definitions/quantity"},
                "surface_area": {"$ref": "#/definitions/quantity"},
                "bounding_box_local": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["min", "max"],
                  "properties": {
                    "min": {"$ref": "#/definitions/quantity"},
                    "max": {"$ref": "#/definitions/quantity"}
                  }
                }
              }
            }
          ]
        },
        "physical": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mass", "center_of_mass", "inertia_about_com"],
              "properties": {
                "mass": {"$ref": "#/definitions/quantity"},
                "center_of_mass": {"$ref": "#/definitions/quantity"},
                "inertia_about_com": {"$ref": "#/definitions/quantity"}
              }
            }
          ]
        },
        "placement": {
          "description": "Pose of the component's local frame in the assembly frame.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["translation", "rotation"],
              "properties": {
                "translation": {"$ref": "#/definitions/quantity"},
                "rotation": {"$ref": "#/definitions/quantity"}
              }
            }
          ]
        },
        "domains": {
          "description": "Per-domain facets. Each facet maps a parameter name to a quantity.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mechanical": {"$ref": "#/definitions/facet"},
            "electrical": {"$ref": "#/definitions/facet"},
            "digital": {"$ref": "#/definitions/facet"},
            "pcb": {"$ref": "#/definitions/facet"},
            "power_electronics": {"$ref": "#/definitions/facet"},
            "control": {"$ref": "#/definitions/facet"},
            "electromagnetic": {"$ref": "#/definitions/facet"},
            "thermal": {"$ref": "#/definitions/facet"}
          }
        }
      }
    },
    "circuit": {
      "description": "A netlist element: its designator, element type, the node each terminal is on (\"0\" is ground), and a switch's .model name. Node names are those the netlist grammar reads: 0, or n_ and 1 to 30 of a-z 0-9 _, so never gnd (ground to ngspice), pa_<digits> (the nodes par() creates) or a name ngspice reads as its own in a .meas, such as time, all or temper; model names are SW_ and 1 to 29 of A-Z 0-9 _, so never TEMPER or GND.",
      "type": "object",
      "additionalProperties": false,
      "required": ["designator", "element", "terminals"],
      "properties": {
        "designator": {"type": "string", "pattern": "^[RCVIS][A-Z0-9_]{1,31}$"},
        "element": {"enum": ["resistor", "capacitor", "voltage_source", "current_source", "voltage_controlled_switch"]},
        "model": {"type": "string", "pattern": "^SW_[A-Z0-9_]{1,29}$"},
        "terminals": {
          "type": "object",
          "propertyNames": {"enum": ["p", "n", "cp", "cn"]},
          "additionalProperties": {"type": "string", "pattern": "^(0|n_[a-z0-9_]{1,30})$"}
        }
      },
      "allOf": [
        {
          "description": "A switch has a model and four terminals; no other element has a model, and every other has exactly p and n.",
          "if": {"properties": {"element": {"const": "voltage_controlled_switch"}}},
          "then": {"required": ["model"], "properties": {"designator": {"pattern": "^S"}, "terminals": {"required": ["p", "n", "cp", "cn"]}}},
          "else": {"not": {"required": ["model"]}, "properties": {"terminals": {"required": ["p", "n"], "maxProperties": 2}}}
        },
        {"if": {"properties": {"element": {"const": "resistor"}}}, "then": {"properties": {"designator": {"pattern": "^R"}}}},
        {"if": {"properties": {"element": {"const": "capacitor"}}}, "then": {"properties": {"designator": {"pattern": "^C"}}}},
        {"if": {"properties": {"element": {"const": "voltage_source"}}}, "then": {"properties": {"designator": {"pattern": "^V"}}}},
        {"if": {"properties": {"element": {"const": "current_source"}}}, "then": {"properties": {"designator": {"pattern": "^I"}}}}
      ]
    },
    "hdlName": {"type": "string", "pattern": "^(?!ecad_)[A-Za-z_][A-Za-z0-9_]{0,63}$"},
    "hdl": {
      "description": "Where a component sits in the elaborated HDL design (format 1.2.0): its module, the sample file that defines it and its ports. The top lists the signals it declares; an instance names its hierarchical path, the facet that holds each parameter value the top passes, the top signal each port connects to, and its module's source text verbatim, bound to design.sources by hash. Behaviour is carried only as that text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "source", "ports"],
      "properties": {
        "module": {"$ref": "#/definitions/hdlName"},
        "source": {"$ref": "common.schema.json#/definitions/relativePath"},
        "instance": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}(\\.[A-Za-z_][A-Za-z0-9_]{0,63})+$"},
        "parameters": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/definitions/hdlName"},
          "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "ports": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {"$ref": "#/definitions/hdlName"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction", "width"],
            "properties": {
              "direction": {"enum": ["input", "output"]},
              "width": {"type": "integer", "minimum": 1, "maximum": 64},
              "signal": {"$ref": "#/definitions/hdlName"}
            }
          }
        },
        "signals": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {"$ref": "#/definitions/hdlName"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "width"],
            "properties": {
              "kind": {"enum": ["reg", "wire"]},
              "width": {"type": "integer", "minimum": 1, "maximum": 64}
            }
          }
        },
        "text": {"type": "string", "minLength": 1, "maxLength": 1048576}
      },
      "allOf": [
        {
          "description": "An instance carries its parameters, its module's text and each port's signal, and no signals; the top carries its signals, no parameters, no text and no ports.",
          "if": {"required": ["instance"]},
          "then": {
            "required": ["parameters", "text"],
            "not": {"required": ["signals"]},
            "properties": {"ports": {"additionalProperties": {"required": ["signal"]}}}
          },
          "else": {
            "required": ["signals"],
            "not": {"anyOf": [{"required": ["parameters"]}, {"required": ["text"]}]},
            "properties": {"ports": {"maxProperties": 0}}
          }
        }
      ]
    },
    "facet": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/definitions/quantity"}
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joint_id", "type", "parent", "child", "realized_by", "axis", "origin", "limits"],
      "properties": {
        "joint_id": {"$ref": "#/definitions/identifier"},
        "type": {"enum": ["revolute", "prismatic", "fixed"]},
        "parent": {"$ref": "#/definitions/identifier"},
        "child": {"$ref": "#/definitions/identifier"},
        "realized_by": {"oneOf": [{"$ref": "#/definitions/identifier"}, {"type": "null"}]},
        "axis": {"$ref": "#/definitions/quantity"},
        "origin": {"$ref": "#/definitions/quantity"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "upper"],
          "properties": {
            "lower": {"$ref": "#/definitions/quantity"},
            "upper": {"$ref": "#/definitions/quantity"}
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "from", "to", "source"],
      "properties": {
        "relation": {
          "enum": [
            "contains",
            "mounted_to",
            "connected_to",
            "drives",
            "powered_by",
            "controls",
            "senses",
            "attached_to",
            "constrained_by",
            "thermally_connected_to"
          ]
        },
        "from": {"$ref": "#/definitions/identifier"},
        "to": {"$ref": "#/definitions/identifier"},
        "source": {"$ref": "common.schema.json#/definitions/source"}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "needed_by"],
      "properties": {
        "path": {"$ref": "common.schema.json#/definitions/nonEmptyString"},
        "status": {"enum": ["UNKNOWN", "UNSPECIFIED", "NOT_AVAILABLE"]},
        "needed_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/definitions/engineeringDomain"}
        },
        "note": {"$ref": "common.schema.json#/definitions/nonEmptyString"}
      }
    }
  }
}
