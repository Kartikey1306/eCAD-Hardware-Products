{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://embeddedos.org/schemas/cad-dataset/v1/source-provenance.schema.json",
  "title": "eCAD Dataset Sample Source Provenance v1",
  "description": "Hand-authored facts about where a sample's source artefact came from and on what terms it may be used. The builder copies these into the manifest and never supplies them itself: a licence the code filled in would be a licence nobody checked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "provenance_version",
    "description",
    "artifact_type",
    "artifact_version",
    "units",
    "coordinate_system",
    "created_at",
    "collected_at",
    "origin",
    "license"
  ],
  "properties": {
    "$schema": {"const": "https://embeddedos.org/schemas/cad-dataset/v1/source-provenance.schema.json"},
    "provenance_version": {"const": "1.0.0"},
    "description": {"$ref": "#/definitions/nonEmptyString"},
    "artifact_type": {"enum": ["step_assembly", "spice_netlist", "hdl_source", "kicad_project", "control_model", "other"]},
    "artifact_version": {"$ref": "#/definitions/nonEmptyString"},
    "units": {
      "description": "Units the source artefact is authored in, e.g. \"mm\" for a STEP file.",
      "$ref": "#/definitions/nonEmptyString"
    },
    "coordinate_system": {"$ref": "#/definitions/nonEmptyString"},
    "created_at": {"description": "When the source artefact was authored (ISO 8601 date).", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "collected_at": {"description": "When it entered the dataset (ISO 8601 date).", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "author"],
      "properties": {
        "kind": {"enum": ["self_authored", "third_party"]},
        "author": {"$ref": "#/definitions/nonEmptyString"},
        "url": {"type": "string", "format": "uri"},
        "modifications": {"$ref": "#/definitions/nonEmptyString"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "third_party"}}}, "then": {"required": ["url", "modifications"]}}
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "attribution", "license_verified", "redistribution_permitted", "training_use_permitted", "basis"],
      "properties": {
        "spdx": {"$ref": "#/definitions/nonEmptyString"},
        "attribution": {"$ref": "#/definitions/nonEmptyString"},
        "license_verified": {
          "description": "True only once a person has read the licence text that governs this artefact.",
          "type": "boolean"
        },
        "license_text_sha256": {"$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/sha256"},
        "redistribution_permitted": {"type": "boolean"},
        "training_use_permitted": {"type": "boolean"},
        "basis": {"$ref": "#/definitions/nonEmptyString"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"origin": {"properties": {"kind": {"const": "third_party"}}}}},
      "then": {"properties": {"license": {"required": ["license_text_sha256"]}}}
    }
  ],
  "definitions": {
    "nonEmptyString": {"$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/nonEmptyString"}
  }
}
