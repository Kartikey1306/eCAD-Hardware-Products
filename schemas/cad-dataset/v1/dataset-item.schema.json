{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://embeddedos.org/schemas/cad-dataset/v1/dataset-item.schema.json",
  "title": "eCAD CAD Dataset Item v1",
  "description": "One dataset item: its source CAD with licence and provenance, its hand-authored inputs, every derived artifact with the tool that produced it, and the honest status of each engineering domain. Generated by the dataset builder; hashes bind it to exact bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "dataset_item_version", "item_id", "title", "source", "inputs", "derived", "domains"],
  "properties": {
    "$schema": {"const": "https://embeddedos.org/schemas/cad-dataset/v1/dataset-item.schema.json"},
    "dataset_item_version": {"const": "1.0.0"},
    "item_id": {"$ref": "#/definitions/identifier"},
    "title": {"$ref": "#/definitions/nonEmptyString"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cad", "origin", "license"],
      "properties": {
        "cad": {"$ref": "#/definitions/artifact"},
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "author"],
          "properties": {
            "kind": {"enum": ["self_authored", "third_party"]},
            "author": {"$ref": "#/definitions/nonEmptyString"},
            "generator": {"$ref": "#/definitions/artifact"},
            "url": {"type": "string", "format": "uri"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "third_party"}}},
              "then": {"required": ["url"]}
            }
          ]
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "attribution", "redistribution_permitted", "training_use_permitted", "basis"],
          "properties": {
            "spdx": {"$ref": "#/definitions/nonEmptyString"},
            "attribution": {"$ref": "#/definitions/nonEmptyString"},
            "redistribution_permitted": {"type": "boolean"},
            "training_use_permitted": {"type": "boolean"},
            "basis": {
              "description": "Why the licence fields are believed: e.g. self-authored under the repository licence, or the upstream licence text at a pinned URL.",
              "$ref": "#/definitions/nonEmptyString"
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotations", "requirements"],
      "properties": {
        "annotations": {"$ref": "#/definitions/artifact"},
        "requirements": {"$ref": "#/definitions/artifact"}
      }
    },
    "derived": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "artifact", "producer", "derived_from"],
        "properties": {
          "role": {"enum": ["cad_extraction", "engineering_model", "mechanical_model", "golden_cases", "corner_cases"]},
          "artifact": {"$ref": "#/definitions/artifact"},
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "version"],
            "properties": {
              "tool": {"$ref": "#/definitions/nonEmptyString"},
              "version": {"$ref": "#/definitions/nonEmptyString"}
            }
          },
          "derived_from": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/definitions/relativePath"}
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "status", "reason"],
        "properties": {
          "domain": {"$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/engineeringDomain"},
          "status": {"enum": ["implemented", "blocked", "not_started"]},
          "reason": {"$ref": "#/definitions/nonEmptyString"}
        }
      }
    }
  },
  "definitions": {
    "identifier": {"$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/identifier"},
    "nonEmptyString": {"$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/nonEmptyString"},
    "relativePath": {"$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/relativePath"},
    "artifact": {"$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/artifact"}
  }
}
