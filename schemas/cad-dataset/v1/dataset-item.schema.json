{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://embeddedos.org/schemas/cad-dataset/v1/dataset-item.schema.json",
  "title": "eCAD CAD Dataset Item v1",
  "description": "One dataset item: its source artefacts with licence and provenance, its hand-authored inputs, every derived artifact with the tool that produced it, and the honest status of each engineering domain. Generated by the dataset builder; hashes bind it to exact bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "dataset_item_version",
    "item_id",
    "domain",
    "source_url",
    "title",
    "description",
    "artifact_type",
    "artifact_version",
    "units",
    "coordinate_system",
    "created_at",
    "collected_at",
    "hash",
    "versions",
    "source",
    "inputs",
    "derived",
    "domains"
  ],
  "properties": {
    "$schema": {
      "const": "https://embeddedos.org/schemas/cad-dataset/v1/dataset-item.schema.json"
    },
    "dataset_item_version": {
      "const": "1.0.0"
    },
    "item_id": {
      "$ref": "#/definitions/identifier"
    },
    "domain": {
      "description": "The sample's primary engineering domain, from its provenance.",
      "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/engineeringDomain"
    },
    "source_url": {
      "description": "Where the source artefacts came from; null only for a self-authored sample, which has no upstream.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "uri"
        }
      ]
    },
    "title": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "description": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "artifact_type": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "artifact_version": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "units": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "coordinate_system": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "collected_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "hash": {
      "description": "Digest of every file git lists for the sample except this manifest (paths and contents).",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "versions": {
      "description": "Versions of the code that produced this sample's derived files. The simulator's version is a property of a run and is recorded in each receipt, not here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraction",
        "engineering_model",
        "domain_models",
        "simulation",
        "validation_contract"
      ],
      "properties": {
        "extraction": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "engineering_model": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "domain_models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "simulation": {
          "description": "Digest of the committed simulation scripts: what this sample runs. Never the simulator's version.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "validation_contract": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "origin",
        "license"
      ],
      "properties": {
        "artifacts": {
          "description": "The source artefacts the provenance declares, with their formats and exact hashes.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/sourceArtifact"
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "author"
          ],
          "properties": {
            "kind": {
              "enum": [
                "self_authored",
                "third_party"
              ]
            },
            "author": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "generator": {
              "$ref": "#/definitions/artifact"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "modifications": {
              "$ref": "#/definitions/nonEmptyString"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "third_party"
                  }
                }
              },
              "then": {
                "required": [
                  "url"
                ]
              }
            }
          ]
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spdx",
            "attribution",
            "license_verified",
            "redistribution_permitted",
            "training_use_permitted",
            "basis"
          ],
          "properties": {
            "spdx": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "attribution": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "redistribution_permitted": {
              "type": "boolean"
            },
            "training_use_permitted": {
              "type": "boolean"
            },
            "basis": {
              "description": "Why the licence fields are believed: e.g. self-authored under the repository licence, or the upstream licence text at a pinned URL.",
              "$ref": "#/definitions/nonEmptyString"
            },
            "license_verified": {
              "type": "boolean"
            },
            "license_text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/relativePath"
                },
                "sha256": {
                  "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/sha256"
                }
              }
            },
            "verified_by": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "verified_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "annotations",
        "requirements",
        "simulation"
      ],
      "properties": {
        "annotations": {
          "$ref": "#/definitions/artifact"
        },
        "requirements": {
          "$ref": "#/definitions/artifact"
        },
        "provenance": {
          "$ref": "#/definitions/artifact"
        },
        "simulation": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/artifact"
          }
        }
      }
    },
    "derived": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "artifact",
          "producer",
          "derived_from"
        ],
        "properties": {
          "role": {
            "enum": [
              "extraction",
              "engineering_model",
              "domain_model",
              "golden_cases",
              "corner_cases"
            ]
          },
          "domain": {
            "description": "Set on files a domain adapter produced: its extraction and its domain model.",
            "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/engineeringDomain"
          },
          "artifact": {
            "$ref": "#/definitions/artifact"
          },
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "version"
            ],
            "properties": {
              "tool": {
                "$ref": "#/definitions/nonEmptyString"
              },
              "version": {
                "$ref": "#/definitions/nonEmptyString"
              }
            }
          },
          "derived_from": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/relativePath"
            }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "status",
          "reason"
        ],
        "properties": {
          "domain": {
            "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/engineeringDomain"
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "NOT_APPLICABLE",
              "NOT_IMPLEMENTED"
            ],
            "description": "In the specification's words, from the platform's registry of domain adapters, never from the sample: AVAILABLE when a registered adapter validates the domain from one of the sample's artefacts, NOT_APPLICABLE when an adapter exists but the sample has no artefact it reads, NOT_IMPLEMENTED when no adapter exists. A sample's missing inputs show up as BLOCKED checks in its receipt."
          },
          "reason": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    }
  },
  "definitions": {
    "identifier": {
      "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/identifier"
    },
    "nonEmptyString": {
      "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/nonEmptyString"
    },
    "relativePath": {
      "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/relativePath"
    },
    "artifact": {
      "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/artifact"
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "media_type",
        "format"
      ],
      "properties": {
        "path": {
          "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/relativePath"
        },
        "sha256": {
          "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/nonEmptyString"
        },
        "format": {
          "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/identifier"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Only a self-authored sample may have no source URL.",
      "if": {
        "properties": {
          "source_url": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "origin": {
                "properties": {
                  "kind": {
                    "const": "self_authored"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
