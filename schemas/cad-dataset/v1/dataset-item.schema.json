{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://embeddedos.org/schemas/cad-dataset/v1/dataset-item.schema.json",
  "title": "eCAD CAD Dataset Item v1",
  "description": "One dataset item: its source CAD with licence and provenance, its hand-authored inputs, every derived artifact with the tool that produced it, and the honest status of each engineering domain. Generated by the dataset builder; hashes bind it to exact bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "dataset_item_version",
    "item_id",
    "title",
    "description",
    "artifact_type",
    "artifact_version",
    "units",
    "coordinate_system",
    "created_at",
    "collected_at",
    "versions",
    "source",
    "inputs",
    "derived",
    "domains"
  ],
  "properties": {
    "$schema": {
      "const": "https://embeddedos.org/schemas/cad-dataset/v1/dataset-item.schema.json"
    },
    "dataset_item_version": {
      "const": "1.0.0"
    },
    "item_id": {
      "$ref": "#/definitions/identifier"
    },
    "title": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "description": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "artifact_type": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "artifact_version": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "units": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "coordinate_system": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "collected_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "versions": {
      "description": "Versions of the code that produced this sample's derived files. The simulator's version is a property of a run and is recorded in each receipt, not here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraction",
        "engineering_model",
        "domain_models",
        "validation_contract"
      ],
      "properties": {
        "extraction": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "engineering_model": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "domain_models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "validation_contract": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cad",
        "origin",
        "license"
      ],
      "properties": {
        "cad": {
          "$ref": "#/definitions/artifact"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "author"
          ],
          "properties": {
            "kind": {
              "enum": [
                "self_authored",
                "third_party"
              ]
            },
            "author": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "generator": {
              "$ref": "#/definitions/artifact"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "modifications": {
              "$ref": "#/definitions/nonEmptyString"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "third_party"
                  }
                }
              },
              "then": {
                "required": [
                  "url"
                ]
              }
            }
          ]
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spdx",
            "attribution",
            "license_verified",
            "redistribution_permitted",
            "training_use_permitted",
            "basis"
          ],
          "properties": {
            "spdx": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "attribution": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "redistribution_permitted": {
              "type": "boolean"
            },
            "training_use_permitted": {
              "type": "boolean"
            },
            "basis": {
              "description": "Why the licence fields are believed: e.g. self-authored under the repository licence, or the upstream licence text at a pinned URL.",
              "$ref": "#/definitions/nonEmptyString"
            },
            "license_verified": {
              "type": "boolean"
            },
            "license_text_sha256": {
              "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/sha256"
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "annotations",
        "requirements",
        "simulation"
      ],
      "properties": {
        "annotations": {
          "$ref": "#/definitions/artifact"
        },
        "requirements": {
          "$ref": "#/definitions/artifact"
        },
        "provenance": {
          "$ref": "#/definitions/artifact"
        },
        "simulation": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/artifact"
          }
        }
      }
    },
    "derived": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "artifact",
          "producer",
          "derived_from"
        ],
        "properties": {
          "role": {
            "enum": [
              "cad_extraction",
              "engineering_model",
              "mechanical_model",
              "golden_cases",
              "corner_cases"
            ]
          },
          "artifact": {
            "$ref": "#/definitions/artifact"
          },
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "version"
            ],
            "properties": {
              "tool": {
                "$ref": "#/definitions/nonEmptyString"
              },
              "version": {
                "$ref": "#/definitions/nonEmptyString"
              }
            }
          },
          "derived_from": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/relativePath"
            }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "status",
          "reason"
        ],
        "properties": {
          "domain": {
            "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/engineeringDomain"
          },
          "status": {
            "enum": [
              "implemented",
              "not_implemented"
            ],
            "description": "Whether this platform has a validator for the domain. A sample's missing inputs show up as BLOCKED checks in its receipt, not here."
          },
          "reason": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    }
  },
  "definitions": {
    "identifier": {
      "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/identifier"
    },
    "nonEmptyString": {
      "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/nonEmptyString"
    },
    "relativePath": {
      "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/relativePath"
    },
    "artifact": {
      "$ref": "https://embeddedos.org/schemas/engineering-model/v1/common.schema.json#/definitions/artifact"
    }
  }
}
